# DiabRetino AI — Environment Configuration
# Copy this file to .env and adjust values as needed

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false

# Frontend Configuration (used by nginx, change port mapping in docker-compose)
FRONTEND_PORT=3000

# Model Configuration
ACTIVE_MODEL=hybrid_vit_cnn

# Python Environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
